---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="關於 | 悟飯老師"
  description="悟飯老師 kouhan 的 AI 設計筆記、合作與訂閱頁。"
  footerNote="悟飯老師整理 AI 設計、影像生成與 Prompt 工作流。"
>
  <main class="about-page">
    <section class="about-intro">
      <div>
        <p class="eyebrow">關於本站</p>
        <h1>給想把 AI 創作工具用進真實工作的人</h1>
      </div>
      <p>
        悟飯老師 kouhan 以 AI 設計、影像生成、Prompt 寫作與內容工作流為核心，
        整理工具實測、案例觀察與可複用的創作方法。
      </p>
    </section>

    <section class="editor-grid">
      <article class="editor-card">
        <span class="avatar large" aria-hidden="true">KH</span>
        <h2>悟飯老師</h2>
        <p>主理人，關注 AI 影像、內容系統與設計交付流程。</p>
      </article>
      <article class="editor-card">
        <span class="avatar large coral" aria-hidden="true">AI</span>
        <h2>內容方向</h2>
        <p>整理 AI 設計趨勢、工具實測、提示詞案例與工作室筆記。</p>
      </article>
      <article class="editor-card">
        <span class="avatar large gold" aria-hidden="true">GO</span>
        <h2>合作方式</h2>
        <p>可延伸為指令包、案例庫、品牌內容顧問與 AI 工作流設計。</p>
      </article>
    </section>

    <section class="contact-panel">
      <div>
        <p class="eyebrow">合作與訂閱</p>
        <h2>訂閱悟飯老師的 AI 設計筆記</h2>
      </div>
      <form class="contact-form">
        <label>
          <span>電子郵件</span>
          <input type="email" placeholder="hello@example.com" />
        </label>
        <button type="submit">加入名單</button>
      </form>
    </section>
  </main>
</BaseLayout>
