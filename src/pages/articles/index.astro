---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { sortPosts } from "../../lib/posts";

const posts = sortPosts(await getCollection("posts"));
---

<BaseLayout
  title="文章 | 把 AI 放進設計流程"
  description="把 AI 放進設計流程的文章列表，整理 AI 設計、影像生成與 Prompt 工作流。"
  footerNote="悟飯老師 kouhan 的 Prompt、影像生成與內容工作流筆記。"
>
  <main class="archive-page">
    <section class="archive-intro">
      <p class="eyebrow">文章庫</p>
      <h1>評測、教學、案例與工作筆記</h1>
      <p>每篇文章都來自 Markdown 檔案，讀者也可用關鍵字快速縮小範圍。</p>
      <label class="search-field">
        <span>搜尋</span>
        <input data-article-search type="search" placeholder="輸入主題、欄目或作者" />
      </label>
    </section>

    <section class="archive-list" aria-live="polite">
      {posts.map((post) => <PostCard post={post} variant="archive" />)}
    </section>
  </main>
</BaseLayout>
