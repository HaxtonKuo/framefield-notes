---
const pathname = Astro.url.pathname;
const nav = [
  { href: "/", label: "首頁", current: pathname === "/" },
  { href: "/articles/", label: "文章", current: pathname.startsWith("/articles/") },
  { href: "/downloads/", label: "下載", current: pathname === "/downloads/" },
  { href: "/articles/image-workflow/", label: "專題", current: pathname === "/articles/image-workflow/" },
  { href: "/about/", label: "關於", current: pathname === "/about/" },
];
---

<header class="site-header">
  <a class="brand" href="/" aria-label="悟飯老師首頁">
    <span>
      <strong>悟飯老師</strong>
      <small>kouhan AI NOTES</small>
    </span>
  </a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
    Menu
  </button>
  <nav id="site-nav" class="site-nav" aria-label="主選單">
    {
      nav.map((item) => (
        <a href={item.href} aria-current={item.current ? "page" : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
